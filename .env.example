# Salin ke .env.local untuk pembangunan. Jangan commit nilai sebenar.
# Semua nilai di sini ialah rahsia server sahaja. Jangan guna awalan NEXT_PUBLIC_.

# Vercel Blob: stor persisten untuk katalog (JSON berversi), audit log dan PDF sumber.
# Diisi automatik oleh Vercel apabila Blob store disambungkan ke projek.
# Kosong dalam pembangunan → aplikasi membaca data/catalog daripada repo.
# Guna store berasingan untuk Development, Preview dan Production.
BLOB_READ_WRITE_TOKEN=

# Rahsia sesi pentadbir (Fasa 6). Jana: openssl rand -base64 32
AUTH_SECRET=

# Emel pentadbir pertama untuk scripts/create-admin.ts (Fasa 6). Tiada kata laluan lalai.
ADMIN_BOOTSTRAP_EMAIL=
