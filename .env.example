# Salin ke .env.local untuk pembangunan. Jangan commit nilai sebenar.
# Semua nilai di sini ialah rahsia server sahaja. Jangan guna awalan NEXT_PUBLIC_.

# Vercel Blob: stor persisten untuk katalog (JSON berversi), audit log dan PDF sumber.
# Diisi automatik oleh Vercel apabila Blob store disambungkan ke projek.
# Kosong dalam pembangunan → aplikasi membaca data/catalog daripada repo.
# Guna store berasingan untuk Development, Preview dan Production.
BLOB_READ_WRITE_TOKEN=

# Rahsia tandatangan sesi pentadbir (≥ 32 aksara). Jana: openssl rand -base64 32
# Berbeza bagi setiap persekitaran. Menukarnya membatalkan semua sesi.
AUTH_SECRET=

# Emel lalai untuk `pnpm admin:create` (pilihan). Tiada kata laluan lalai; kata laluan diminta
# melalui prompt. ADMIN_PASSWORD hanya untuk automasi/ujian dan jangan disimpan dalam fail ini.
ADMIN_BOOTSTRAP_EMAIL=

# Pembangunan/E2E sahaja: direktori stor setempat (draf, pengguna, audit, PDF) jika tiada Blob.
# Diabaikan apabila BLOB_READ_WRITE_TOKEN ditetapkan. Tidak dibenarkan dalam production.
PJH_LOCAL_STORE=
